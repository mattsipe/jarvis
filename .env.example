# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# In a DEV run, this file must sit at the project root (loaded from cwd).
# In an INSTALLED build (Windows or a packaged Mac build), JARVIS instead
# reads it from the per-user app data folder — see config.ts. Same file,
# same format, just place it at:
#   Windows: %APPDATA%\jarvis\.env
#   macOS:   ~/Library/Application Support/jarvis/.env

# --- Required for the core voice loop (M2) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# JARVIS's voice — already chosen, leave as-is unless you want a different one.
ELEVENLABS_VOICE_ID=2eG0V12z6Hg7luZwRG2V

# --- Optional ---
# STT provider: "deepgram" (default, low-latency streaming) or "whisper" (local, offline fallback)
STT_PROVIDER=deepgram

# Global push-to-talk / toggle hotkey (Electron accelerator format)
JARVIS_HOTKEY=Control+Space

# Opens/closes the Command Center window from anywhere
JARVIS_COMMAND_CENTER_HOTKEY=Control+Shift+Space

# Hard cap (minutes) on one continuous voice session, regardless of activity
JARVIS_MAX_SESSION_MINUTES=10

# Dev safety valve: stop synthesizing (but keep showing text) past this many
# characters of TTS in one session. Leave unset for no cap.
# TTS_DEV_CHAR_CAP=

# Update channel: "test" (default — installs prerelease/test builds, e.g.
# 0.2.0-test.1) or "stable" (only plain-semver releases, once those exist)
JARVIS_UPDATE_CHANNEL=test

# --- Phase 2 (M6 — Outlook / Microsoft Graph), not needed yet ---
# MS_CLIENT_ID=
# MS_TENANT_ID=
