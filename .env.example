# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Required for the core voice loop (M2) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# JARVIS's voice — already chosen, leave as-is unless you want a different one.
ELEVENLABS_VOICE_ID=2eG0V12z6Hg7luZwRG2V

# --- Optional ---
# STT provider: "deepgram" (default, low-latency streaming) or "whisper" (local, offline fallback)
STT_PROVIDER=deepgram

# Global push-to-talk / toggle hotkey (Electron accelerator format)
JARVIS_HOTKEY=Control+Space

# --- Phase 2 (M6 — Outlook / Microsoft Graph), not needed yet ---
# MS_CLIENT_ID=
# MS_TENANT_ID=
