# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# In a DEV run, this file must sit at the project root (loaded from cwd).
# In an INSTALLED build (Windows or a packaged Mac build), JARVIS instead
# reads it from the per-user app data folder — see config.ts. Same file,
# same format, just place it at:
#   Windows: %APPDATA%\jarvis\.env
#   macOS:   ~/Library/Application Support/jarvis/.env

# --- Required for the core voice loop (M2) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# JARVIS's voice — already chosen, leave as-is unless you want a different one.
ELEVENLABS_VOICE_ID=2eG0V12z6Hg7luZwRG2V

# --- Optional ---
# STT provider: "deepgram" (default, low-latency streaming) or "whisper" (local, offline fallback)
STT_PROVIDER=deepgram

# Global push-to-talk / toggle hotkey (Electron accelerator format)
JARVIS_HOTKEY=Control+Space

# Opens/closes the Command Center window from anywhere
JARVIS_COMMAND_CENTER_HOTKEY=Control+Shift+Space

# Mutes/unmutes the mic globally (wake-word listening included)
JARVIS_MUTE_HOTKEY=Control+Shift+M

# Hard cap (minutes) on one continuous voice session, regardless of activity
JARVIS_MAX_SESSION_MINUTES=10

# Dev safety valve: stop synthesizing (but keep showing text) past this many
# characters of TTS in one session. Leave unset for no cap.
# TTS_DEV_CHAR_CAP=

# Update channel: "test" (default — installs prerelease/test builds, e.g.
# 0.2.0-test.1) or "stable" (only plain-semver releases, once those exist)
JARVIS_UPDATE_CHANNEL=test

# --- API usage & budget manager (src/main/usage/) ---
# These only SEED the budget on first run — after that, Command Center's
# Usage & Budget panel is the source of truth (persisted to
# userData/budget-config.json) and editing there wins. Leave a value blank
# or set it to "unlimited" for no limit on that period/tier.
# Master switch — set to "false" to disable all budget enforcement (usage
# is still tracked either way):
# JARVIS_BUDGET_PROTECTION_ENABLED=true
# JARVIS_BUDGET_DAILY_SOFT_USD=3
# JARVIS_BUDGET_DAILY_HARD_USD=8
# JARVIS_BUDGET_MONTHLY_SOFT_USD=40
# JARVIS_BUDGET_MONTHLY_HARD_USD=100
# Safety net for one runaway multi-step agent turn (tool-loop), independent
# of the $ limits above:
# JARVIS_MAX_TURN_TOKENS=40000
# JARVIS_MAX_TURN_SECONDS=180
# Override the estimated $/unit rates usage/pricing.ts uses to turn raw
# token/minute/char counts into a dollar figure (JSON, deep-merged over the
# built-in defaults) — these are cost ESTIMATES for the budget UI, not a
# claim about any provider's actual pricing or free tier:
# JARVIS_PRICING_OVERRIDES_JSON={"deepgramPerMinuteUsd":0.0043}

# --- Presence / hands-free wake word (src/main/presence/) ---
# Optional — without a Picovoice AccessKey, Presence just stays disabled
# and JARVIS falls back to the Control+Space hotkey exactly as before.
# Get a free AccessKey from the Picovoice Console, then either set it here
# or paste it into Command Center -> Integrations (no restart needed).
# PICOVOICE_ACCESS_KEY=
# Porcupine wake-word sensitivity, 0-1 — higher catches more true wakes at
# the cost of more false ones.
# JARVIS_WAKE_WORD_SENSITIVITY=0.5
# Master switch, seeds Command Center's Presence panel on first run only
# (the panel's own toggle wins after that):
# JARVIS_PRESENCE_ENABLED=true
# Start JARVIS hidden in the tray on Windows login (also toggleable from
# the Presence panel, which is the one that actually calls
# app.setLoginItemSettings — this only seeds the persisted default):
# JARVIS_LAUNCH_AT_LOGIN=false

# --- Phase 2 (M6 — Outlook / Microsoft Graph), not needed yet ---
# MS_CLIENT_ID=
# MS_TENANT_ID=
